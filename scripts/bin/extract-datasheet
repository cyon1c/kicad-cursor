#!/usr/bin/env sh
# Invoke the extract-datasheet step from the kicad-cursor repo.
set -e
repoRoot=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
cd "$repoRoot"

if [ "$#" -eq 0 ]; then
    uv run python scripts/extract_datasheet.py --help
    exit 1
fi

exec uv run python scripts/extract_datasheet.py "$@"
