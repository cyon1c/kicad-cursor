#!/usr/bin/env sh
# Manage named board targets in kicad-cursor.yaml from any directory (e.g. `kicad-projects use pdn-kit-hardware`).
set -e
self=$(readlink -f -- "$0")
repoRoot=$(CDPATH= cd -- "$(dirname -- "$self")/../.." && pwd)
exec uv run --quiet --project "$repoRoot" python "$repoRoot/scripts/manage_projects.py" "$@"
